  "components": {
    "securitySchemes": {
      "demoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Generated local demo token; never embedded in the contract."
      }
    },
    "schemas": {
      "Supplier": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supplier_id",
          "supplier_code",
          "supplier_name",
          "region",
          "active"
        ],
        "properties": {
          "supplier_id": {
            "type": "string",
            "pattern": "^SUP-[0-9]{3}$"
          },
          "supplier_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "supplier_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "enum": [
              "NORTH",
              "SOUTH",
              "WEST"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_id",
          "catalog_reference",
          "supplier_id",
          "supplier_sku",
          "unit_cost",
          "currency_code",
          "unit_code",
          "minimum_order_quantity",
          "available_quantity",
          "lead_time_days",
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "offer_id": {
            "type": "string",
            "pattern": "^OF-[0-9]{4}$"
          },
          "catalog_reference": {
            "type": "string",
            "pattern": "^CAT-[0-9]{4}$"
          },
          "supplier_id": {
            "type": "string",
            "pattern": "^SUP-[0-9]{3}$"
          },
          "supplier_sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit_cost": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})[.][0-9]{2}$"
          },
          "currency_code": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP"
            ]
          },
          "unit_code": {
            "type": "string",
            "enum": [
              "EA",
              "BOX",
              "M"
            ]
          },
          "minimum_order_quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "available_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "lead_time_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      },
      "SupplierList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "total",
          "snapshotVersion"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Supplier"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "snapshotVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "OfferList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "total",
          "snapshotVersion"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "snapshotVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "snapshotVersion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready"
            ]
          },
          "snapshotVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
