        "operationId": "listSuppliers",
        "description": "Ascending stable ID. Unknown or duplicate query parameters are rejected. Beyond-end pages return an empty array.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
