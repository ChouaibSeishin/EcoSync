{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "split",
    "category",
    "question",
    "operation",
    "parameters",
    "requiredSources",
    "permissions",
    "datasetVersion",
    "mappingVersion",
    "sourceVersions",
    "expectedRef"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[DH][0-9]{2}$"
    },
    "split": {
      "enum": [
        "development",
        "held-out"
      ]
    },
    "category": {
      "enum": [
        "single-source",
        "two-source",
        "three-source",
        "identifier-matching",
        "ambiguous",
        "unauthorized",
        "unavailable-invalid-credentials",
        "malformed-oversized",
        "partial-results",
        "complexity-result-size"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 15
    },
    "operation": {
      "enum": [
        "revenue",
        "stock",
        "suppliers",
        "bundle",
        "match",
        "clarify",
        "policy",
        "fault",
        "inventory-offers",
        "page",
        "window",
        "currency-totals",
        "offer-boundary",
        "top-products"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "requiredSources": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "sales",
          "inventory",
          "supplier"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sales": {
          "enum": [
            "sales_reader",
            "invalid-password"
          ]
        },
        "inventory": {
          "const": "inventory_reader"
        },
        "supplier": {
          "enum": [
            "bearer-read",
            "unauthenticated",
            "invalid-bearer"
          ]
        }
      }
    },
    "datasetVersion": {
      "const": "1.0.0"
    },
    "mappingVersion": {
      "const": "1.0.0"
    },
    "sourceVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sales",
        "inventory",
        "supplier"
      ],
      "properties": {
        "sales": {
          "const": "sales-v1"
        },
        "inventory": {
          "const": "inventory-v1"
        },
        "supplier": {
          "const": "supplier-v1"
        }
      }
    },
    "expectedRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
